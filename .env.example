# dev | staging | production. staging/production require DEBUG=False and AWS_STORAGE_BUCKET_NAME.
ENVIRONMENT=dev
# Required (non-empty) whenever DEBUG=False.
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://pri_backend:pri_backend_dev_password@localhost:5435/pri_backend

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Deployed only, e.g. https://api.staging.example.org
CSRF_TRUSTED_ORIGINS=
# HTTPS hardening; defaults to on for staging/production and off for dev.
# SECURE_SSL_REDIRECT=
# SESSION_COOKIE_SECURE=
# CSRF_COOKIE_SECURE=
# SECURE_HSTS_SECONDS=

# Optional — S3-compatible object storage (AWS S3 or DigitalOcean Spaces).
# Leave AWS_STORAGE_BUCKET_NAME unset to keep local disk storage for dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Deployed environments only (read by deploy/docker-compose.*.yml, not by Django)
# IMAGE=ghcr.io/prikeralam/website-backend:<tag>
# SERVER_NAME=api.staging.example.org
# Staging only: the Postgres container's credentials (DATABASE_URL must match, host `db`)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
