# The backend's site before its certificate exists (the name doesn't point at this host yet).
# Serves the app over plain HTTP so deploys and health checks work; Django redirects everything
# except /healthz/ to HTTPS, which starts working once pri-nginx-site finds a certificate.

server {
    listen 80;
    server_name ${SERVER_NAME};
    include snippets/acme.conf;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
